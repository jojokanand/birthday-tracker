# Copy to .env (gitignored) and fill in.
# In production, these come from Google Secret Manager, not a file.

# --- Backend ---
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO

# --- GCP ---
GCP_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=               # set for local/integration tests, leave blank in prod

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Gmail API (OAuth) ---
# Path to OAuth client secrets JSON downloaded from GCP Console.
GMAIL_OAUTH_CLIENT_SECRETS_PATH=
GMAIL_OAUTH_TOKEN_PATH=                # where the refresh token is cached
GMAIL_FROM_ADDRESS=

# --- Self-serve form ---
PUBLIC_BASE_URL=http://localhost:3000  # used to build links in outbound messages
FORM_TOKEN_SECRET=                     # HMAC secret for signing form tokens
